{
  "name": "trippleviral-server",
  "version": "1.0.0",
  "description": "Backend API for Tripple Viral Content Scheduler",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"const fs=require('fs'),p=require('path');function cp(s,d){fs.mkdirSync(d,{recursive:true});for(const f of fs.readdirSync(s)){const sp=p.join(s,f),dp=p.join(d,f);if(fs.statSync(sp).isDirectory())cp(sp,dp);else if(f.endsWith('.sql'))fs.copyFileSync(sp,dp);}}cp('src/migrations/sql','dist/migrations/sql');\"",
    "start": "node dist/index.js",
    "migrate": "node dist/migrations/runner.js",
    "migrate:dev": "tsx src/migrations/runner.ts",
    "test:dryrun": "tsx --test src/services/__tests__/storyAgent.dryrun.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@aws-sdk/client-s3": "^3.1009.0",
    "@aws-sdk/s3-request-presigner": "^3.1010.0",
    "archiver": "^7.0.1",
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "dropbox": "^10.34.0",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "ffmpeg-static": "^5.3.0",
    "form-data": "^4.0.4",
    "google-auth-library": "^10.6.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "officeparser": "^7.1.0",
    "openai": "^4.0.0",
    "pg": "^8.11.3",
    "probe-image-size": "^7.3.0",
    "stripe": "^20.4.1"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.10.9",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
